eval "$(direnv hook zsh)"

# See: https://qiita.com/lichtshinoza/items/ed03f42614ee5605974d
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Leaner Technologies
alias cdl='cd ~/src/github.com/leaner-co-jp/leaner-procurement/server'
alias railsc='docker compose -f ~/src/github.com/leaner-co-jp/leaner-procurement/server/docker-compose.without-leaner-id.yml exec rails bundle exec rails c'
alias rspec='docker compose -f ~/src/github.com/leaner-co-jp/leaner-procurement/server/docker-compose.without-leaner-id.yml exec rails bundle exec rspec'
alias rubo='docker compose -f ~/src/github.com/leaner-co-jp/leaner-procurement/server/docker-compose.without-leaner-id.yml exec rails bundle exec rubocop -a'

source ~/.safe-chain/scripts/init-posix.sh
